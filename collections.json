            "structure": {
              "when_visualize_true": {
                "type": "StreamingResponse",
                "headers": {
                  "X-Florence-Results": "JSON string of detections"
                },
                "body": "PNG image with detection boxes"
              },
              "when_visualize_false": {
                "type": "application/json",
                "normalized_structure_example": {
                  "ok": true,
                  "task": "detection",
                  "model": "florence",
                  "results": {
                    "bboxes": [[100, 150, 250, 300], [50, 200, 150, 350]],
                    "labels": ["person", "dog"],
                    "scores": [0.95, 0.87]
                  }
                }
              }
            }
          },
          "batch_support": true
        },
        {
          "id": "florence_open_vocab_detection",
          "name": "open_vocab_detection",
          "path": "/open_vocab_detection",
          "method": "POST",
          "task_type": "open_vocab_detection",
          "description": "Open vocabulary object detection with user-specified categories",
          "sync_processing": true,
          "input": {
            "required": [
              {
                "name": "file",
                "type": "UploadFile | List[UploadFile]"
