          "output": {
            "content_type": ["image/png", "application/json"],
            "structure": {
              "when_visualize_true": {
                "type": "StreamingResponse",
                "headers": {
                  "X-Florence-Results": "JSON string of segmentation results"
                },
                "body": "PNG image with segmentation mask overlay"
              },
              "when_visualize_false": {
                "type": "application/json",
                "normalized_structure_example": {
                  "ok": true,
                  "task": "referring_expression_segmentation",
                  "model": "florence",
                  "results": {
                    "polygons": [[[100, 150], [120, 150], [120, 170], [100, 170]]],
                    "labels": ["red car"],
                    "bboxes": [[100, 150, 120, 170]],
                    "masks": "base64_encoded_mask_data_here"
                  },
                  "artifacts": ["mask", "overlay"]
                }
              }
            }
          },
          "batch_support": true
        },
        {
