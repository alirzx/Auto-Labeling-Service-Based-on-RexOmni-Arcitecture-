                "default": true
              }
            ]
          },
          "output": "Same as /caption_grounding",
          "batch_support": true
        },
        {
          "id": "florence_object_detection",
          "name": "object_detection",
          "path": "/object_detection",
          "method": "POST",
          "task_type": "detection",
          "description": "Standard object detection with predefined categories",
