{
  "project": {
    "name": "Vision+Language Auto Annotation Platform",
    "version": "2.1.0",
    "description": "Production-grade auto-labeling service with Florence-2 foundation model",
    "api_version": "v1",
    "base_url": "http://localhost:6996",
    "status": "active",
    "last_updated": "2026-01-29"
  },

  "system_architecture": {
    "job_processing": {
      "type": "asynchronous_with_sync_fallback",
      "storage": "local_file_system",
      "artifact_location": "./job_artifacts",
      "supported_formats": ["png", "jpeg"],
      "max_concurrent_jobs": 10
    },
    "supported_inputs": {
      "image_formats": ["jpg", "jpeg", "png", "bmp", "webp"],
      "max_file_size": "10MB",
      "batch_processing": true,
      "multipart_form": true
    },
    "current_models": {
      "active": ["florence"],
      "inactive": ["rexomni"],
      "note": "RexOmni adapter is currently commented out in model registry"
    }
  },

  "backbone_models": [
    {
      "id": "florence",
      "name": "Florence-2",
      "type": "vision_foundation_model",
      "provider": "Microsoft",
      "status": "active",
      "description": "Florence-2: Unified vision foundation model with multi-task capabilities via prompt-based interface",
      "capabilities": [
        "captioning",
        "visual_grounding",
        "object_detection",
        "open_vocab_detection",
        "segmentation",
        "region_reasoning",
        "ocr",
        "dense_captioning"
      ],
      "default_tasks": "all"
    }
  ],

  "api_endpoints": {
    "florence": {
      "base_path": "/vision/florence",
      "prefix": "/vision/florence",
      "endpoints": [
        {
          "id": "florence_caption",
          "name": "caption",
          "path": "/caption",
          "method": "POST",
          "description": "Generate basic image caption",
          "task_type": "caption",
          "sync_processing": true,
          "input": {
            "required": [
              {
                "name": "file",
                "type": "UploadFile | List[UploadFile]",
                "format": "multipart/form-data",
                "description": "Single image file or array of image files for batch processing"
              }
            ],
            "optional": [
              {
                "name": "visualize",
                "type": "boolean",
                "default": true,
                "description": "Return visualized image with annotations. If false, returns JSON only"
              }
            ],
            "note": "text_input is NOT required for basic captioning (registry correction)"
          },
          "output": {
            "content_type": ["image/png", "application/json"],
            "structure": {
              "when_visualize_true": {
                "type": "StreamingResponse",
                "headers": {
                  "X-Florence-Results": "Base64 encoded JSON string containing results"
                },
                "body": "PNG image bytes with caption overlay"
              },
              "when_visualize_false": {
                "type": "application/json",
                "structure_example": {
                  "results": ["A beautiful sunset over the mountains", "A scenic mountain landscape at dusk"]
                }
              }
            },
            "normalized_format": {
              "ok": true,
              "task": "caption",
              "model": "florence",
              "results": "array of caption strings",
              "artifacts": ["overlay"]
            }
          },
          "batch_support": true,
          "max_batch_size": 10
        },
        {
          "id": "florence_caption_detailed",
          "name": "caption_detailed",
          "path": "/caption_detailed",
          "method": "POST",
          "description": "Generate detailed image caption",
          "task_type": "caption_detailed",
          "sync_processing": true,
          "input": {
            "required": [
              {
                "name": "file",
                "type": "UploadFile | List[UploadFile]",
                "format": "multipart/form-data"
              }
            ],
            "optional": [
              {
                "name": "visualize",
                "type": "boolean",
                "default": true
              }
            ],
            "note": "text_input is NOT required (registry correction)"
          },
          "output": "Same as /caption endpoint",
          "batch_support": true
        },
        {
          "id": "florence_caption_more_detailed",
          "name": "caption_more_detailed",
          "path": "/caption_more_detailed",
          "method": "POST",
          "description": "Generate more detailed image caption",
          "task_type": "caption_more_detailed",
          "sync_processing": true,
          "input": {
            "required": [
              {
                "name": "file",
                "type": "UploadFile | List[UploadFile]"
              }
            ],
            "optional": [
              {
                "name": "visualize",
                "type": "boolean",
                "default": true
              }
            ],
            "note": "text_input is NOT required (registry correction)"
          },
          "output": "Same as /caption endpoint",
          "batch_support": true
        },
        {
          "id": "florence_caption_grounding",
          "name": "caption_grounding",
          "path": "/caption_grounding",
          "method": "POST",
          "description": "Generate caption with visual grounding of mentioned objects",
          "task_type": "caption_grounding",
          "sync_processing": true,
          "input": {
            "required": [
              {
                "name": "file",
                "type": "UploadFile | List[UploadFile]"
              },
              {
                "name": "text_input",
                "type": "string",
                "description": "Caption text that will be grounded in the image"
              }
            ],
            "optional": [
              {
                "name": "visualize",
                "type": "boolean",
                "default": true
              }
            ]
          },
          "output": {
            "content_type": ["image/png", "application/json"],
            "structure": {
              "when_visualize_true": {
                "type": "StreamingResponse",
                "headers": {
                  "X-Florence-Results": "JSON string with bounding boxes and captions"
                },
                "body": "PNG image with grounding boxes"
              },
              "when_visualize_false": {
                "type": "application/json",
                "structure_example": {
                  "results": [
                    {
                      "caption": "A dog running in the park",
                      "bboxes": [[100, 150, 250, 300], [50, 200, 150, 350]],
                      "labels": ["dog", "person"]
                    }
                  ]
                }
              }
            }
          },
          "batch_support": true
        },
        {
          "id": "florence_caption_grounding_detailed",
          "name": "caption_grounding_detailed",
          "path": "/caption_grounding_detailed",
          "method": "POST",
          "task_type": "caption_grounding_detailed",
          "description": "Detailed caption with visual grounding",
          "sync_processing": true,
          "input": {
            "required": [
              {
                "name": "file",
                "type": "UploadFile | List[UploadFile]"
              },
              {
                "name": "text_input",
                "type": "string"
              }
            ],
            "optional": [
              {
                "name": "visualize",
                "type": "boolean",
                "default": true
              }
            ]
          },
          "output": "Same as /caption_grounding",
          "batch_support": true
        },
        {
          "id": "florence_caption_grounding_more_detailed",
          "name": "caption_grounding_more_detailed",
          "path": "/caption_grounding_more_detailed",
          "method": "POST",
          "task_type": "caption_grounding_more_detailed",
          "description": "More detailed caption with visual grounding",
          "sync_processing": true,
          "input": {
            "required": [
              {
                "name": "file",
                "type": "UploadFile | List[UploadFile]"
              },
              {
                "name": "text_input",
                "type": "string"
              }
            ],
            "optional": [
              {
                "name": "visualize",
                "type": "boolean",
                "default": true
              }
            ]
          },
          "output": "Same as /caption_grounding",
          "batch_support": true
        },
        {
          "id": "florence_caption_to_phrase_grounding",
          "name": "caption_to_phrase_grounding",
          "path": "/caption_to_phrase_grounding",
          "method": "POST",
          "task_type": "caption_to_phrase_grounding",
          "description": "Generate caption and ground specific phrases in the image",
          "sync_processing": true,
          "input": {
            "required": [
              {
                "name": "file",
                "type": "UploadFile | List[UploadFile]"
              },
              {
                "name": "text_input",
                "type": "string",
