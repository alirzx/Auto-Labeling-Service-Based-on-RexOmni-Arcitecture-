              {
                "name": "categories",
                "type": "string",
                "description": "Comma-separated list of categories to detect (e.g., 'car,person,dog')"
              }
            ],
            "optional": [
              {
                "name": "visualize",
                "type": "boolean",
                "default": true
              }
            ]
          },
          "output": {
            "content_type": ["image/png", "application/json"],
            "structure": {
              "when_visualize_true": {
                "type": "StreamingResponse",
                "headers": {
                  "X-Florence-Results": "JSON string of detections"
                },
                "body": "PNG image with detection boxes"
              },
              "when_visualize_false": {
                "type": "application/json",
                "normalized_structure_example": {
                  "ok": true,
                  "task": "open_vocab_detection",
                  "model": "florence",
                  "results": {
                    "bboxes": [[100, 150, 250, 300], [50, 200, 150, 350]],
                    "labels": ["car", "traffic light"],
                    "scores": [0.92, 0.78]
                  }
                }
              }
            }
          },
          "batch_support": true
        },
        {
          "id": "florence_referring_expression_segmentation",
          "name": "referring_expression_segmentation",
          "path": "/referring_expression_segmentation",
          "method": "POST",
          "task_type": "referring_expression_segmentation",
