          "input": {
            "required": [
              {
                "name": "file",
                "type": "UploadFile | List[UploadFile]"
              },
              {
                "name": "text_input",
                "type": "string",
                "description": "Region specification"
              }
            ],
            "optional": [
              {
                "name": "visualize",
                "type": "boolean",
                "default": true
              }
            ]
          },
          "output": {
            "content_type": ["image/png", "application/json"],
            "structure": {
              "when_visualize_true": {
                "type": "StreamingResponse",
                "headers": {
                  "X-Florence-Results": "JSON string of category results"
                },
                "body": "PNG image with region annotations"
              },
              "when_visualize_false": {
