    "job_management": {
      "base_path": "/api/jobs",
      "prefix": "/api/jobs",
      "async_processing_only": true,
      "endpoints": [
        {
          "id": "get_available_tasks",
          "name": "get_available_tasks",
          "path": "/tasks",
          "method": "GET",
          "description": "Get all available tasks for a specific model with their required inputs",
          "input": {
            "query_parameters": [
              {
                "name": "model",
                "type": "string",
                "required": true,
                "description": "Model name: 'florence' (rexomni currently unavailable)",
                "allowed_values": ["florence"]
              }
            ]
          },
          "output": {
            "content_type": "application/json",
            "structure_example": {
              "tasks": [
                "caption",
                "caption_detailed",
                "caption_more_detailed",
                "caption_grounding",
                "caption_grounding_detailed",
                "caption_grounding_more_detailed",
                "caption_to_phrase_grounding",
                "detection",
                "open_vocab_detection",
                "referring_expression_segmentation",
                "region_segmentation",
                "region_category",
                "region_description",
                "region_proposal",
                "dense_region_caption",
                "ocr",
                "ocr_with_region"
              ],
              "required_inputs": {
                "caption": [],
                "caption_detailed": [],
                "caption_more_detailed": [],
                "caption_grounding": ["text_input"],
                "caption_grounding_detailed": ["text_input"],
                "caption_grounding_more_detailed": ["text_input"],
                "caption_to_phrase_grounding": ["text_input"],
                "detection": [],
                "open_vocab_detection": ["categories"],
                "referring_expression_segmentation": ["text_input"],
                "region_segmentation": ["text_input"],
                "region_category": ["text_input"],
                "region_description": ["text_input"],
                "region_proposal": [],
                "dense_region_caption": [],
                "ocr": [],
                "ocr_with_region": []
              }
            }
          }
        },
        {
          "id": "create_job",
          "name": "create_job",
          "path": "",
          "method": "POST",
          "description": "Submit a new annotation job for async processing",
          "input": {
            "multipart_form": [
              {
                "name": "file",
                "type": "UploadFile",
                "required": true,
                "description": "Single image file (batch not supported in jobs)"
              },
              {
                "name": "task",
                "type": "string",
                "required": true,
                "description": "Task type from available tasks list"
              },
              {
                "name": "model",
                "type": "string",
                "required": true,
                "description": "Model to use: 'florence'",
                "allowed_values": ["florence"]
              },
              {
                "name": "text_input",
                "type": "string",
                "required": false,
                "description": "Text input for tasks that require it (check required_inputs)"
              }
            ]
          },
          "output": {
            "content_type": "application/json",
            "structure_example": {
              "job_id": "123e4567-e89b-12d3-a456-426614174000"
            }
          }
        },
        {
          "id": "read_job",
          "name": "read_job",
          "path": "/{job_id}",
          "method": "GET",
          "description": "Get job status, progress, and metadata",
          "input": {
            "path_parameters": [
              {
                "name": "job_id",
                "type": "string",
